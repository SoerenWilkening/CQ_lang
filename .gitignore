
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
cmake-build-debug
transpiler/build*
/build/
# A second configure of the SAME tree, used to pin a BEFORE plugin while working:
#   cmake -S . -B build-baseline -DLLVM_DIR=... && cmake --build build-baseline --target CQPass
# so "this free was sound before the change" is MEASURED against a real artifact
# instead of derived from reading the diff. Worth keeping around.
/build-baseline/
# A third configure, for compile-checking work-in-progress WITHOUT swapping the
# plugin under a review that is measuring against /build/.
/build-inc3/
# A fourth configure, with ASSERTIONS ENABLED (bd ziuw). The shipped plugin is
# Release/-DNDEBUG, so every `assert` in the pass — e.g. the pure-callee driver's
# frame-pairing and drain asserts — is compiled OUT and is documentation only.
# This dir turns them back into a runnable gate:
#   cmake -S . -B build-assert -DLLVM_DIR=$(brew --prefix llvm@19)/lib/cmake/llvm \
#         -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_FLAGS= -DCMAKE_CXX_FLAGS_RELEASE=-O2
# *** NOT `-DCMAKE_CXX_FLAGS=-UNDEBUG`: CMake appends CMAKE_CXX_FLAGS_RELEASE's
# own `-DNDEBUG` AFTER it, so that spelling silently yields a binary with no
# asserts at all. Prove the instrument is live before trusting its silence —
# `strings build-assert/ir-pass/cq-opt | grep <your assert message>`. ***
/build-assert/
/build-5pio/
/Testing/
.claude
.idea
.DS_Store
IMG_2423.jpg
'build

