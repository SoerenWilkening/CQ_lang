; taint_accept_spec_classical_return_clone_arg.ll — ACCEPT (bd test_C_libtooling-9bhg).
;
; bd l3oi Rule-13 round 7 F-R7-1's shape (a specialization-classical value passed
; to ANOTHER defined function) ONE FUNCTION BOUNDARY OUT. A TWO-TU module (caller
; TU `-include CQ.h`, llvm-linked with a plain-C library TU, as
; tests/e2e/run_slice_multi.sh builds one).
;
; `f` returns `t = h(q, m)`, whose clone proves the CLASSICAL `k + 1`; `main` passes
; `f(m)` to `g`. Had the provisional taint of `t` crossed `f`'s return, `g(f(m))`
; would have been a specialization SITE at detection with slot 0 masked quantum,
; its clone built reading the integer as a register handle (F-R7-1 in the caller).
; Because provisional taint does not cross (`returnTaintIsSpecProvisional`),
; `g(f(m))` is an ordinary classical call: no clone of `g`, no gate in `main` —
; the pre-3jru (aad63450) stream.
;
; Library TU (plain C, no CQ.h):
;   int h(int a, int k) { return k + 1; }
;   int g(int a) { return a * 3 + 1; }
;   int g2(int a, int b) { return a + b; }
;
; Caller TU (clang -O1 -include CQ.h):
;   #include <stdlib.h>
;   #include <stdio.h>
;   int h(int a, int k); int g(int a); int g2(int a, int b);
;   __attribute__((noinline)) int f(int m) { int q = cq_theta(m, .5); int t = h(q, m); return t; }
;   int main(int argc, char **argv) { int m = atoi(argv[1]); int u = g(f(m)); return u; }
;
; Regenerate: clang -O1 -emit-llvm -S each TU as above, then
;   llvm-link -S caller.ll lib.ll -o <this file's body>.
;
; RUN: %cq-opt -load-pass-plugin %cq-pass -passes=cq-lowering -S %s 2>&1 \
; RUN:   | %filecheck %s --implicit-check-not=__cq_q_g_
; CHECK-NOT: error
; CHECK-LABEL: define i32 @f(
; CHECK: %h = call i32 @cqrt_alloc_i32(i32 %0)
; CHECK-NEXT: call void @cqrt_ry_i32(i32 %h, double 5.000000e-01)
; CHECK-NEXT: [[T:%[0-9]+]] = tail call i32 @__cq_q_h_01(i32 noundef %h, i32 noundef %0)
; CHECK-NEXT: ret i32 [[T]]
; CHECK-LABEL: define i32 @main(
; CHECK-NOT: cq{{rt|_template}}_
; CHECK: [[R:%[0-9]+]] = tail call i32 @f(i32 noundef %5)
; CHECK-NEXT: [[U:%[0-9]+]] = tail call i32 @g(i32 noundef [[R]])
; CHECK-NEXT: ret i32 [[U]]
