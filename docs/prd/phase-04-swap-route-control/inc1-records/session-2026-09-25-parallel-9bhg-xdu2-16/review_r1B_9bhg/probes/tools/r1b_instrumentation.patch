+// ===== r1B reviewer instrumentation (NOT for commit): CQ_NOFREE=1 makes every
+// global operator delete a no-op, so a freed address is never reused and a
+// dangling key can never alias a live value (the detector then sees it as
+// dangling deterministically). CQ_SCRIBBLE=1 additionally fills freed memory
+// with 0xDB bytes WITHOUT freeing it (a later deref of a stale pointer then reads
+// garbage deterministically rather than a reused live object).
+#include <cstdlib>
+#include <cstring>
+#include <malloc/malloc.h>
+#include <new>
+static int r1bMode() {
+  static int Mode = -1;
+  if (Mode < 0) {
+    Mode = 0;
+    if (getenv("CQ_NOFREE")) Mode = 1;
+    if (getenv("CQ_SCRIBBLE")) Mode = 2;
+    if (getenv("CQ_REUSE")) Mode = 3;
+  }
+  return Mode;
+}
+// Mode 3: a deterministic LIFO exact-class free list (max reuse): a freed block
+// is handed to the very next allocation of the same malloc size class.
+#include <vector>
+#include <map>
+static std::map<size_t, std::vector<void *>> *r1bFL() {
+  static std::map<size_t, std::vector<void *>> *FL = nullptr;
+  if (!FL) FL = (std::map<size_t, std::vector<void *>> *)0x1;  // sentinel
+  return FL;
+}
+static bool r1bInFL = false;
+struct R1BPool { size_t cls; void *p; };
+static R1BPool *r1bPool = nullptr; static size_t r1bPoolN = 0, r1bPoolCap = 0;
+static void r1bPush(size_t cls, void *p) {
+  if (r1bPoolN == r1bPoolCap) {
+    size_t nc = r1bPoolCap ? r1bPoolCap * 2 : 1 << 16;
+    r1bPool = (R1BPool *)std::realloc(r1bPool, nc * sizeof(R1BPool));
+    r1bPoolCap = nc;
+  }
+  r1bPool[r1bPoolN++] = {cls, p};
+}
+static void *r1bPop(size_t cls) {
+  // LIFO: search from the top for the most recently freed block of this class
+  // (bounded scan so it stays cheap).
+  size_t lim = r1bPoolN > 4096 ? r1bPoolN - 4096 : 0;
+  for (size_t i = r1bPoolN; i > lim; --i)
+    if (r1bPool[i - 1].cls == cls) {
+      void *p = r1bPool[i - 1].p;
+      r1bPool[i - 1] = r1bPool[--r1bPoolN];
+      return p;
+    }
+  return nullptr;
+}
+static void r1bFree(void *P) noexcept {
+  if (!P) return;
+  int m = r1bMode();
+  if (m == 0) { std::free(P); return; }
+  if (m == 2) { size_t n = malloc_size(P); std::memset(P, 0xDB, n); }
+  if (m == 3) { r1bPush(malloc_size(P), P); }
+}
+void operator delete(void *P) noexcept { r1bFree(P); }
+void operator delete[](void *P) noexcept { r1bFree(P); }
+void operator delete(void *P, std::size_t) noexcept { r1bFree(P); }
+void operator delete[](void *P, std::size_t) noexcept { r1bFree(P); }
+static void *r1bNew(std::size_t n) {
+  if (!n) n = 1;
+  if (r1bMode() == 3) { if (void *q = r1bPop(malloc_good_size(n))) return q; }
+  void *p = std::malloc(n); if (!p) throw std::bad_alloc(); return p;
+}
+void *operator new(std::size_t n) { return r1bNew(n); }
+void *operator new[](std::size_t n) { return r1bNew(n); }
