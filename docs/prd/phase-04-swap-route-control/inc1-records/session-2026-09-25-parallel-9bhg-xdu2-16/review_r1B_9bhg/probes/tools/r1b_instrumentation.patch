+// r1B: deletion hooks on every Tainted key, reporting a delete while still a key.
+#include "llvm/IR/ValueHandle.h"
+namespace r1b {
+const char *LastStage = "start";
+const cq::TaintSet *Watched = nullptr;
+struct DelVH final : public llvm::CallbackVH {
+  DelVH(llvm::Value *V) : CallbackVH(V) {}
+  void deleted() override {
+    llvm::Value *V = getValPtr();
+    bool Key = Watched && Watched->Tainted.count(V);
+    if (Key) {
+      std::string S; llvm::raw_string_ostream OS(S);
+      V->print(OS);
+      std::string Fn = "?";
+      if (auto *I = llvm::dyn_cast<llvm::Instruction>(V)) if (I->getParent() && I->getFunction()) Fn = I->getFunction()->getName().str();
+      llvm::errs() << "R1B-DEL after=" << LastStage << " ptr=" << (void*)V << " fn=" << Fn << " :: " << OS.str() << "\n";
+    }
+    setValPtr(nullptr);
+  }
+};
+std::vector<std::unique_ptr<DelVH>> Hooks;
+llvm::DenseSet<const llvm::Value *> Hooked;
+void arm(const cq::TaintSet &T) {
+  Watched = &T;
+  for (llvm::Value *V : T.Tainted)
+    if (!llvm::isa<llvm::Constant>(V) && Hooked.insert(V).second)
+      Hooks.push_back(std::make_unique<DelVH>(V));
+}
+}
+// ===== r1B reviewer instrumentation (NOT for commit): dangling side-table keys.
+static void r1bDangle(Module &M, const TaintSet &taint, const char *Stage) {
+  static const bool On = getenv("CQ_DANGLE") != nullptr || getenv("CQ_ALIAS") != nullptr;
+  static const bool DOn = getenv("CQ_DANGLE") != nullptr;
+  if (!On)
+    return;
+  if (DOn) {
+  llvm::DenseSet<const void *> Live;
+  for (GlobalValue &G : M.global_values())
+    Live.insert(&G);
+  for (Function &F : M) {
+    Live.insert(&F);
+    for (Argument &A : F.args())
+      Live.insert(&A);
+    for (BasicBlock &BB : F) {
+      Live.insert(&BB);
+      for (Instruction &I : BB)
+        Live.insert(&I);
+    }
+  }
+  auto chk = [&](const char *Tbl, const void *P) {
+    if (!P || Live.count(P))
+      return;
+    // Constants are uniqued and never erased from IR; they are live as values.
+    llvm::errs() << "R1B-DANGLE stage=" << Stage << " table=" << Tbl
+                 << " ptr=" << P << "\n";
+  };
+  for (Value *V : taint.Tainted)
+    if (!isa<Constant>(V) || isa<GlobalValue>(V)) chk("Tainted", V);
+  for (auto &KV : taint.BirthOrder) chk("BirthOrder", KV.first);
+  for (auto &KV : taint.HandleWidth) chk("HandleWidth", KV.first);
+  for (auto *I : taint.StaleDeclined) chk("StaleDeclined", I);
+  for (auto *I : taint.ValueArmConeOps) chk("ValueArmConeOps", I);
+  for (auto *I : taint.LiftedConsumers) chk("LiftedConsumers", I);
+  for (auto *V : taint.ControlOwnedRails) chk("ControlOwnedRails", V);
+  for (auto *V : taint.OutputRails) chk("OutputRails", V);
+  for (auto *V : taint.GraveyardRails) chk("GraveyardRails", V);
+  for (auto *V : taint.UntaintedMergeRails) chk("UntaintedMergeRails", V);
+  for (auto *I : taint.InPlaceRailOps) chk("InPlaceRailOps", I);
+  for (auto &KV : taint.InPlaceRailIdx) chk("InPlaceRailIdx", KV.first);
+  for (auto *I : taint.PreLoopCommittedInPlaceOps) chk("PreLoopCommitted", I);
+  for (auto &KV : taint.SpecHandleArgMask) chk("SpecHandleArgMask", KV.first);
+  for (auto *C : taint.ThetaCalls) chk("ThetaCalls", C);
+  for (auto *C : taint.MeasureCalls) chk("MeasureCalls", C);
+  for (auto *C : taint.PhaseCalls) chk("PhaseCalls", C);
+  for (auto *C : taint.UserSourceRotations) chk("UserSourceRotations", C);
+  for (auto *C : taint.UserChainedRotations) chk("UserChainedRotations", C);
+  for (auto *C : taint.UserPhaseRotations) chk("UserPhaseRotations", C);
+  for (auto *C : taint.SpineOps) chk("SpineOps", C);
+  for (auto *C : taint.DischargedFlagGates) chk("DischargedFlagGates", C);
+  for (auto *P : taint.PromotedCarriedHandlePhis) chk("PromotedPhis", P);
+  for (auto &KV : taint.GuardedStores) chk("GuardedStores", KV.first);
+  for (auto &KV : taint.IOTapeForFn) chk("IOTapeForFn", KV.first);
+  for (auto &KV : taint.SharedCondFlags) { chk("SharedCondFlags.k", KV.first); if (KV.second && !isa<Constant>(KV.second)) chk("SharedCondFlags.v", KV.second); }
+  for (auto &KV : taint.ControlledRotations) chk("ControlledRotations.k", KV.first);
+  }
+  // ALIAS check: a value in a specializer-created function (__cq_q_*) can never
+  // legitimately be a key of the MODULE taint (C-Taint disjointness), so a hit is
+  // a dangling key whose address was reused by a clone value.
+  if (getenv("CQ_ALIAS"))
+    for (Function &F : M)
+      if (F.getName().starts_with("__cq_q_"))
+        for (BasicBlock &BB : F)
+          for (Instruction &I : BB) {
+            bool T = taint.Tainted.count(&I), H = taint.HandleWidth.count(&I),
+                 B = taint.BirthOrder.count(&I);
+            if (T || H || B) {
+              std::string S; llvm::raw_string_ostream OS(S); I.print(OS);
+              llvm::errs() << "R1B-ALIAS stage=" << Stage << " fn=" << F.getName()
+                           << " T=" << T << " H=" << H << " B=" << B << " :: " << OS.str() << "\n";
+            }
+          }
+  llvm::errs() << "R1B-CHECKPOINT " << Stage << " tainted=" << taint.Tainted.size() << "\n";
+  r1b::LastStage = Stage;
+  if (getenv("CQ_DELHOOK")) r1b::arm(taint);
+}
+
