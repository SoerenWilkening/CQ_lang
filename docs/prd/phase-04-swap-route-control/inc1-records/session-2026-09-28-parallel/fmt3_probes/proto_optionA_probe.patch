diff --git a/ir-pass/src/ArmClassify.cpp b/ir-pass/src/ArmClassify.cpp
index ffa5b832..4aba1ab4 100644
--- a/ir-pass/src/ArmClassify.cpp
+++ b/ir-pass/src/ArmClassify.cpp
@@ -2250,6 +2250,45 @@ bool f2SeedPinnedByLiveRegister(const ControlRegion &Region, Constant *Seed,
       }
     }
   }
+  // FMT3-PROBE (PHASE-1 MEASUREMENT PROTOTYPE — NEVER COMMITTED). Reports, but
+  // never acts on, the two coarse-fence variants of option (A). Verdict is
+  // byte-identical to the oracle whether or not the env var is set.
+  if (getenv("CQ_FMT3_PROBE")) {
+    const BasicBlock *ArmBBs[] = {Region.Arm, Region.ArmFalse};
+    bool A1 = false, A2 = false;
+    std::string W1, W2;
+    for (BasicBlock &BB : *F)
+      for (Instruction &In : BB) {
+        if (!Taint.Tainted.count(&In) || In.getType()->isVoidTy())
+          continue;
+        if (&BB == ArmBBs[0] || (ArmBBs[1] && &BB == ArmBBs[1]))
+          continue;  // the prep itself
+        if (CondWire.count(&In) || Taint.isPeelClone(&In) || PhiDesc.count(&In))
+          continue;
+        Type *Ty = In.getType();
+        if (!Ty->isIntegerTy() && !Ty->isFloatingPointTy())
+          continue;
+        if (!A2) {
+          A2 = true;
+          raw_string_ostream(W2) << In;
+        }
+        if (Ty != Seed->getType())
+          continue;
+        bool Contains = true;
+        if (auto *SC = dyn_cast<ConstantInt>(Seed)) {
+          ConstantRange R = f2Refine(&In, ConstantRange::getFull(Ty->getIntegerBitWidth()),
+                                     DL, &AC, DT);
+          Contains = R.contains(SC->getValue());
+        }
+        if (Contains && !A1) {
+          A1 = true;
+          raw_string_ostream(W1) << In;
+        }
+      }
+    errs() << "FMT3-PROBE fn=" << F->getName() << " prep-passes-F2"
+           << " A1=" << A1 << " A2=" << A2 << " w1=[" << W1 << "] w2=[" << W2
+           << "]\n";
+  }
   return false;
 }
 
