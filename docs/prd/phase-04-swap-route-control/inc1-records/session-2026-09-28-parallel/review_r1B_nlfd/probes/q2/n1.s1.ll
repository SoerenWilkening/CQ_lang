; Function Attrs: mustprogress nofree noinline norecurse nosync nounwind ssp willreturn memory(none) uwtable
define range(i32 -2147483647, -2147483648) i32 @h2(i32 noundef %0, i32 noundef %1) local_unnamed_addr #4 {
  %3 = mul nsw i32 %1, %0
