  br i1 %7, label %14, label %15

14:                                               ; preds = %11
  tail call void @cq_phi(double noundef 3.141590e+00) #5
  br label %15

15:                                               ; preds = %14, %11
  %16 = add nuw nsw i32 %12, %13
  %17 = add nuw nsw i32 %13, 1
  %18 = icmp eq i32 %17, %1
  br i1 %18, label %8, label %11, !llvm.loop !6

19:                                               ; preds = %8
  tail call void @cq_phi(double noundef 1.000000e+00) #5
  br label %20

20:                                               ; preds = %19, %8
  %21 = musttail call i32 @h2(i32 noundef %9, i32 noundef %1) #5
  ret i32 %21
}

