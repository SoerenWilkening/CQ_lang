; Function Attrs: nounwind ssp uwtable
define i32 @main(i32 noundef %0, ptr nocapture noundef readnone %1) local_unnamed_addr #0 {
  %3 = add nsw i32 %0, 4
  %4 = and i32 %3, 7
  %5 = tail call i32 @cq_theta_si32(i32 noundef %4, double noundef 5.000000e-01) #4
  %6 = mul nsw i32 %5, 3
  %7 = tail call i32 @h(i32 noundef %6, i32 noundef %3) #5
  %8 = xor i32 %6, %5
  %9 = icmp eq i32 %8, 10
  br i1 %9, label %10, label %11

10:                                               ; preds = %2
  tail call void @cq_phi(double noundef 3.141590e+00) #5
  br label %11

11:                                               ; preds = %10, %2
  %12 = tail call i32 @cq_theta_si32(i32 noundef %5, double noundef 0x3FE6666666666666) #4
  %13 = tail call i32 @cq_measure_si32(i32 noundef %12) #5
  %14 = tail call i32 @cq_measure_si32(i32 noundef %7) #5
  %15 = add nsw i32 %14, %13
  ret i32 %15
}

declare i32 @cq_theta_si32(i32 noundef, double noundef) local_unnamed_addr #1

