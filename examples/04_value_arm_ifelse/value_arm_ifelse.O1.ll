; Function Attrs: nounwind ssp uwtable
define i32 @value_arm_ifelse(i32 noundef %0, double noundef %1, i32 noundef %2, i32 noundef %3, i32 noundef %4) local_unnamed_addr #0 {
  %6 = tail call i32 @cq_theta_si32(i32 noundef %0, double noundef %1) #2    ; C: int x = x0; cq_theta(&x, th);
  %7 = icmp sgt i32 %6, %2    ; C: x > k
  %8 = add nsw i32 %6, %3    ; C: r = x + c;  (then-arm, hoisted)
  %9 = mul nsw i32 %6, %4    ; C: r = x * s;  (else-arm, hoisted)
  %10 = select i1 %7, i32 %8, i32 %9    ; C: if (x > k) ... else ...  (if/else folded to a select)
  %11 = tail call i32 @cq_measure_si32(i32 noundef %10) #3    ; C: cq_measure(r)
  ret i32 %11    ; C: return cq_measure(r);
}

