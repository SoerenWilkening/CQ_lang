; ModuleID = 'volatile_global.c'
source_filename = "volatile_global.c"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-apple-macosx16.0.0"

@tiny = internal global double 1.000000e-300, align 8    ; C: static volatile double tiny  (internal, never written, address never escapes)

; Function Attrs: nounwind ssp uwtable
define double @volatile_global(double noundef %0, double noundef %1, double noundef %2) local_unnamed_addr #0 {
  %4 = tail call double @cq_theta_f64(double noundef %0, double noundef %1) #2    ; C: cq_theta(&x, th);
  %5 = fcmp olt double %4, %2    ; C: if (x < k)
  %6 = load volatile double, ptr @tiny, align 8, !tbaa !6    ; C: tiny  (one volatile read, hoisted out of both arms)
  %7 = fmul double %4, %6    ; C: r = x * tiny;  (then arm)
  %8 = fsub double %4, %6    ; C: r = x - tiny;  (else arm)
  %9 = select i1 %5, double %7, double %8    ; C: r  (the if/else folded into a select)
  %10 = tail call double @cq_measure_f64(double noundef %9) #3    ; C: cq_measure(r)
  ret double %10    ; C: return
}

declare double @cq_theta_f64(double noundef, double noundef) local_unnamed_addr #1

declare double @cq_measure_f64(double noundef) local_unnamed_addr #1

