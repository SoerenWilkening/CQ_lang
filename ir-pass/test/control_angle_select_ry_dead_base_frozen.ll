; control_angle_select_ry_dead_base_frozen.ll — ACCEPT: the rotated register is
; NEVER READ after the gate, and it is still LEAKED rather than freed (bd drbq
; Inc 2b; the freeze's other half).
;
; With no live consumer, the whole-DAG uncompute spine would ordinarily pick the
; register's chain as a dead terminal, reverse it and `cqrt_free` the rail. It
; must NOT here: the rail carries a `cqrt_ry_i32_controlled` whose control flag
; is stripped and freed inside the region's own stream, so both halves of the
; teardown would be wrong (an adjoint naming a freed flag; a free of a rail that
; is entangled with the condition and provably NOT |0>). Rule 6 leaves it
; allocated — a qubit leak, accepted in the qubits-not-scarce regime, and the
; only sound alternative to a hidden measurement.
;
; Read together with `control_angle_select_ry_derived_base_late_use_frozen.ll`:
; that one has a live late use, this one has none, and the emitted teardown is
; the same in both — which is what "frozen" means.
; ORACLE DISPOSITION: RED on the pre-2b binary (`rotation angle under quantum
; control`, SelectClassify gate 3) — Rule 12 red-green.
;
; RUN: %cq-opt -load-pass-plugin %cq-pass -passes=cq-lowering -S %s > %t.cqd0.ll
; RUN: %filecheck %s < %t.cqd0.ll
; RUN: %filecheck %s --check-prefix=CNT     < %t.cqd0.ll
; RUN: %filecheck %s --check-prefix=NOROUTE < %t.cqd0.ll
; 3qlq: migrated from register cq_phi (dead declare erased)

declare i32 @cq_theta_si32(i32, double)
declare i32 @cq_measure_si32(i32)

define i32 @example(i32 %u0, i32 %u1) {
entry:
  %q = call i32 @cq_theta_si32(i32 %u0, double 5.000000e-01)
  %r = call i32 @cq_theta_si32(i32 %u1, double 3.000000e-01)
  %c = icmp eq i32 %q, 5
  %ang = select i1 %c, double 9.000000e-01, double 3.000000e-01
  %t = call i32 @cq_theta_si32(i32 %r, double %ang)
  %mq = call i32 @cq_measure_si32(i32 %q)
  ret i32 %mq
}

