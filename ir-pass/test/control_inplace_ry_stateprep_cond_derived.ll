; control_inplace_ry_stateprep_cond_derived.ll — ACCEPT: the condition is a
; DERIVED expression `(q & 6) == 2` (PRD §14.3 row A-10; probe `p15a`, measured
; NOT to fold — `-O1` leaves the `and` standing and the arm's seed is the source's
; own literal).
;
; Two things this pins. (1) F2 reads the region's COMPARE, which here is
; `icmp eq %and, 2` — the constant `2` is compared against a DERIVED tainted
; value, not against the seed's register, and 2 != 0 anyway, so F2 is silent by
; VALUE and not by shape. (2) the flag is minted from the derived template chain
; and stripped by the same `_unc`, and the prepped rail is disjoint from the
; WHOLE derived chain by construction (§14.5) — Inc 1 needed R4 to prove that,
; Inc 4 does not, because the rail is minted inside the region.
;
; ⚠ The §13.4b residual is unchanged and is a property of the CONDITION: a
; derived condition leaves template rails entangled with `q`, live past the
; strip. Inc 4 neither improves nor worsens it.
;
; RUN: %cq-opt -load-pass-plugin %cq-pass -passes=cq-lowering -S %s > %t.cqd0.ll
; RUN: %filecheck %s < %t.cqd0.ll
; RUN: %filecheck %s --check-prefix=NOROUTE < %t.cqd0.ll
; RUN: %filecheck %s --check-prefix=ACNT    < %t.cqd0.ll
; RUN: %filecheck %s --check-prefix=FCNT    < %t.cqd0.ll

declare i32 @cq_theta_si32(i32, double)
declare i32 @cq_measure_si32(i32)

define i32 @example(i32 %u0) {
entry:
  %q = call i32 @cq_theta_si32(i32 %u0, double 5.000000e-01)
  %a = and i32 %q, 6
  %c = icmp eq i32 %a, 2
  br i1 %c, label %arm, label %merge
arm:
  %rt = call i32 @cq_theta_si32(i32 0, double 9.000000e-01)
  br label %merge
merge:
  %rm = phi i32 [ %rt, %arm ], [ 0, %entry ]
  %mq = call i32 @cq_measure_si32(i32 %q)
  %mr = call i32 @cq_measure_si32(i32 %rm)
  %s  = add i32 %mq, %mr
  ret i32 %s
}

