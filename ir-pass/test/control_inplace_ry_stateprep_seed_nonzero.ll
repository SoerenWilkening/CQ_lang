; control_inplace_ry_stateprep_seed_nonzero.ll — ACCEPT: the seed is NOT |0>.
; PRD §14.3 row A-3, bd test_C_libtooling-drbq Inc 4.
;
;     int q = 3; cq_theta(&q,.3); int r = 7;
;     if (q == 5) { r = 7; cq_theta(&r, .9); }  // seed 7, compare literal 5
;
; The seed is not privileged: `cqrt_alloc_<W>` takes the classical value and the
; rail starts at |7>, exactly as the UNCONTROLLED `int r = 7; cq_theta(&r, θ)` mints today.
; F1 is satisfied because the merge φ's pred incoming is the SAME uniqued
; `ConstantInt 7`, and F2 is silent because 7 != 5.
;
; ⚠ AND THE `7 == 5` VARIANT IS THE WHOLE POINT OF F2: change the seed to `5`
; and the module becomes byte-identical to an in-place Ry on the CONDITION
; register (probe `p06a` ≡ `p08e`, measured), which R4 forbids — see
; control_inplace_ry_reject_stateprep_eqfold_coincidence.ll. One character.
;
; ⚠ NOTE FOR STAGE 2b AND THE GOLDEN AUDIT (PRD §14.6): a non-zero seed is
; INVISIBLE to `free_pairing_check.py` (it classifies `cqrt_alloc_<W>` by symbol
; name and never reads the argument, at any site), and `golden_multiset_audit.py`
; fences its work-rail matcher on the alloc literal being `0`, so this rail is
; not a work rail to it. Neither tool witnesses the seed; F1 does.
;
; RUN: %cq-opt -load-pass-plugin %cq-pass -passes=cq-lowering -S %s > %t.cqd0.ll
; RUN: %filecheck %s < %t.cqd0.ll
; RUN: %filecheck %s --check-prefix=NOROUTE < %t.cqd0.ll
; RUN: %filecheck %s --check-prefix=ACNT    < %t.cqd0.ll
; RUN: %filecheck %s --check-prefix=FCNT    < %t.cqd0.ll

declare i32 @cq_theta_si32(i32, double)
declare i32 @cq_measure_si32(i32)

define i32 @example(i32 %u0) {
entry:
  %q = call i32 @cq_theta_si32(i32 %u0, double 5.000000e-01)
  %c = icmp eq i32 %q, 5
  br i1 %c, label %arm, label %merge
arm:
  %rt = call i32 @cq_theta_si32(i32 7, double 9.000000e-01)
  br label %merge
merge:
  %rm = phi i32 [ %rt, %arm ], [ 7, %entry ]
  %mq = call i32 @cq_measure_si32(i32 %q)
  %mr = call i32 @cq_measure_si32(i32 %rm)
  %s  = add i32 %mq, %mr
  ret i32 %s
}

