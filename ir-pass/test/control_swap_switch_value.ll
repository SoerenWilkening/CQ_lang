; control_swap_switch_value.ll — a clean homogeneous VALUE switch (base p != q).
;
; WI-1 (emit stubbed): each arm is a pure value chain bottoming at the shared
; routed base %p (the straight-through default incoming), p != q (C2 anchor). The
; classifier reaches the would-be-ACCEPT and fires the TRANSITIONAL "switch"
; decline. WI-3 graduates: lands emitSwitchValueRegion (method-B) + stream CHECKs,
; flips accept to push, replaces this RUN.
;
; RUN: not %cq-opt -load-pass-plugin %cq-pass -passes=cq-lowering -S %s 2>&1 | %filecheck %s
; CHECK: error{{.*}}switch under quantum control
declare i32 @cq_theta_si32(i32, double)
declare i32 @cq_measure_si32(i32)
define i32 @example(i32 %u0, i32 %p0) {
entry:
  %q = call i32 @cq_theta_si32(i32 %u0, double 5.000000e-01)
  %p = call i32 @cq_theta_si32(i32 %p0, double 7.000000e-01)
  switch i32 %q, label %merge [ i32 0, label %a0
                                i32 1, label %a1 ]
a0:
  %v0 = add i32 %p, 1
  br label %merge
a1:
  %v1 = add i32 %p, 2
  br label %merge
merge:
  %pm = phi i32 [ %p, %entry ], [ %v0, %a0 ], [ %v1, %a1 ]
  %m = call i32 @cq_measure_si32(i32 %pm)
  ret i32 %m
}
