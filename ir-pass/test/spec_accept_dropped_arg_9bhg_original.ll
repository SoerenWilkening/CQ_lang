; spec_accept_dropped_arg_9bhg_original.ll — ACCEPT (bd test_C_libtooling-9bhg, closed as fixed by bd vsfp).
;
; bd 9bhg's reported over-decline: a function returning the result of a call whose
; callee ignores its quantum argument (`t = h(q, m)`, `h` returns `k + 1`) was refused
; "quantum value returned across a function boundary" (bd 3jru's fence, on
; pre-specialize conservative taint) — main aee8f4f8 declines this module. Since
; bd vsfp (c1136be2) the pre-specialize dead-argument drop rewrites `h`'s unread
; first argument to 0, so `h` is never specialized, `t` is classical, and the module
; lowers like its hand-inlined twin (`int t = m + 1;`). This fixture pins that the
; ORIGINAL program keeps compiling. The 9bhg branch (provisional return taint,
; ordered scrub) was NOT landed: its remaining population from C is musttail
; forwarders only (follow-up bead).
;
; Two TUs, clang -O1 -include CQ.h each, then llvm-link:
;   lib.c:  int h(int a, int k) { return k + 1; }
;   main.c: #include <stdlib.h>
;           int h(int a, int k);
;           __attribute__((noinline)) int f(int m) { int q = cq_theta(m, .5); int t = h(q, m); return t + cq_measure(q); }
;           int main(int c, char **v) { return f(atoi(v[1])); }
;
; RUN: %cq-opt -load-pass-plugin %cq-pass -passes=cq-lowering -S %s 2>&1 \
; RUN:   | %filecheck %s
; CHECK-NOT: error:
; CHECK-LABEL: define i32 @f(
; CHECK: call i32 @cqrt_alloc_i32(
; CHECK: call void @cqrt_ry_i32(i32 %{{[a-z0-9]+}}, double 5.000000e-01)
; CHECK: call i32 @h(i32 noundef 0, i32 noundef %0)
; CHECK: call i32 @cqrt_measure_i32(
; CHECK-NOT: __cq_q_h
; CHECK-NOT: error:

; ModuleID = 'llvm-link'
source_filename = "llvm-link"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-apple-macosx16.0.0"

; Function Attrs: noinline nounwind ssp uwtable
define i32 @f(i32 noundef %0) local_unnamed_addr #0 {
  %2 = tail call i32 @cq_theta_si32(i32 noundef %0, double noundef 5.000000e-01) #5
  %3 = tail call i32 @h(i32 noundef %2, i32 noundef %0) #5
  %4 = tail call i32 @cq_measure_si32(i32 noundef %2) #5
  %5 = add nsw i32 %4, %3
  ret i32 %5
}

declare i32 @cq_theta_si32(i32 noundef, double noundef) local_unnamed_addr #1

declare i32 @cq_measure_si32(i32 noundef) local_unnamed_addr #1

; Function Attrs: nounwind ssp uwtable
define i32 @main(i32 noundef %0, ptr nocapture noundef readonly %1) local_unnamed_addr #2 {
  %3 = getelementptr inbounds i8, ptr %1, i64 8
  %4 = load ptr, ptr %3, align 8, !tbaa !6
  %5 = tail call i32 @atoi(ptr nocapture noundef %4)
  %6 = tail call i32 @f(i32 noundef %5)
  ret i32 %6
}

; Function Attrs: mustprogress nofree nounwind willreturn memory(read)
declare i32 @atoi(ptr nocapture noundef) local_unnamed_addr #3

; Function Attrs: mustprogress nofree norecurse nosync nounwind ssp willreturn memory(none) uwtable
define range(i32 -2147483647, -2147483648) i32 @h(i32 noundef %0, i32 noundef %1) local_unnamed_addr #4 {
  %3 = add nsw i32 %1, 1
  ret i32 %3
}

