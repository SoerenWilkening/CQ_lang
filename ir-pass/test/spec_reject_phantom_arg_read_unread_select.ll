; spec_reject_phantom_arg_read_unread_select.ll — DECLINE (bd test_C_libtooling-tzfa; bd vsfp
; Rule-13 r2B's "B3-style decline for anything left"; hand-written IR, `k1` branch-only).
;
; The phantom operand is `p = b ? 9 : 4`, a 4.4 `%out` rail minted ONLY for the call. After
; the neutralisation nothing in the user program reads it; the twin never computes it, and
; what control emission already built for it (a which-path rail copying `b`, never
; uncomputed) cannot be taken back — kept, it would dephase the later Ry on `b`. Declined.
; An over-decline against the twin, IR-only: the C spelling (`(void)K`) now drops at slot B
; (spec_accept_dropped_arg_volatile_global_arm.ll). Remove the decline (mutant N2) and this
; file accepts the dephased stream.
; ⚠ ROUND 3 (bd tzfa; Rule-13 r2B F-WB-1). A slot the specializer RECORDED dead is now
; NEUTRALISED after `specialize()` (`resolvePhantomCloneArgReads`: the argument becomes `0`,
; the drop's rewrite), so the uncompute spine, M-C, M-A and stage 2b see the hand-inlined
; twin's consumer set. Round 2 instead ACCEPTED a phantom read whose operand had another
; reader and left the read in place — one consumer too many for the spine.
;
;
; bd p3kd.21 R11 r2 F1 (bd r2j3.35, 2026-10-15): `main` now MEASURES the value it
; returns. A register returned from `main` reaches the process exit status without
; `cq_measure`, which NORTHSTAR goal 1 forbids and the pass now refuses
; (spec_reject_gate_sub_main_return.ll); the measurement is outside this fixture's
; subject, which is unchanged.
; RUN: env CQ_DEADARG_DBG=1 not %cq-opt -load-pass-plugin %cq-pass -passes=cq-lowering -S %s -o /dev/null 2>&1 \
; RUN:   | %filecheck %s
; CHECK-NOT: CQ_DEADARG_DBG
; CHECK: error: {{.*}}cq specialization: quantum argument to a parameter the lifted callee never reads

; ModuleID = 'llvm-link'
source_filename = "llvm-link"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-apple-macosx16.0.0"

@K = internal global i32 7, align 4

; Function Attrs: nounwind ssp uwtable
define i32 @main(i32 noundef %0, ptr nocapture noundef readonly %1) local_unnamed_addr #0 {
  %3 = getelementptr inbounds i8, ptr %1, i64 8
  %4 = load ptr, ptr %3, align 8, !tbaa !6
  %5 = tail call i32 @atoi(ptr nocapture noundef %4)
  %6 = and i32 %5, 1
  %7 = icmp ne i32 %6, 0
  %8 = tail call zeroext i1 @cq_theta_i1(i1 noundef zeroext %7, double noundef 5.000000e-01) #4
  %9 = select i1 %8, i32 9, i32 4
  %10 = tail call i32 @h(i32 noundef %9, i32 noundef %5) #4
  %11 = tail call zeroext i1 @cq_theta_i1(i1 noundef zeroext %8, double noundef 0x3FE6666666666666) #4
  %12 = tail call zeroext i1 @cq_measure_i1(i1 noundef zeroext %11) #4
  %13 = zext i1 %12 to i32
  %14 = add nsw i32 %10, %13
  %cq.main.m = call i32 @cq_measure_si32(i32 %14)
  ret i32 %cq.main.m
}

; Function Attrs: mustprogress nofree nounwind willreturn memory(read)
declare i32 @atoi(ptr nocapture noundef) local_unnamed_addr #1

declare zeroext i1 @cq_theta_i1(i1 noundef zeroext, double noundef) local_unnamed_addr #2

declare zeroext i1 @cq_measure_i1(i1 noundef zeroext) local_unnamed_addr #2

; Function Attrs: mustprogress nofree norecurse nounwind ssp willreturn memory(readwrite, argmem: none) uwtable
define range(i32 -2147483647, -2147483648) i32 @h(i32 noundef %0, i32 noundef %1) local_unnamed_addr #3 {
  %3 = icmp sgt i32 %0, 3
  br i1 %3, label %4, label %6

4:                                                ; preds = %2
  br label %6

6:                                                ; preds = %4, %2
  %7 = add nsw i32 %1, 1
  ret i32 %7
}

