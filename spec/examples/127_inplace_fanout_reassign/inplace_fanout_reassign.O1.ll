; Function Attrs: nounwind ssp uwtable
define i32 @inplace_fanout_reassign(i32 noundef %0, double noundef %1, i32 noundef %2) local_unnamed_addr #0 {
  %4 = tail call i32 @cq_theta_si32(i32 noundef %0, double noundef %1) #3
  %5 = add nsw i32 %4, 1
  %6 = mul nsw i32 %4, %2
  %7 = tail call fastcc i32 @f(i32 noundef %4, i32 noundef %5)
  %8 = xor i32 %7, %6
  %9 = tail call i32 @cq_measure_si32(i32 noundef %8) #4
  ret i32 %9
}

declare i32 @cq_theta_si32(i32 noundef, double noundef) local_unnamed_addr #1

; Function Attrs: mustprogress nofree noinline norecurse nosync nounwind ssp willreturn memory(none) uwtable
define internal fastcc noundef i32 @f(i32 noundef %0, i32 noundef %1) unnamed_addr #2 {
  %3 = add i32 %1, 1
  %4 = mul i32 %3, %0
  ret i32 %4
}

