; Function Attrs: mustprogress nocallback nofree nosync nounwind willreturn
declare void @llvm.va_end.p0(ptr) #2

; Function Attrs: mustprogress nocallback nofree nosync nounwind willreturn memory(argmem: readwrite)
declare void @llvm.lifetime.end.p0(i64 immarg, ptr nocapture) #1

; Function Attrs: nounwind ssp uwtable
define i32 @stream_body(i8 noundef signext %0) local_unnamed_addr #4 {
  %2 = tail call signext i8 @cq_theta_si8(i8 noundef signext %0, double noundef 3.000000e-01) #8
  %3 = tail call fastcc i32 @show(i8 noundef signext %2)
  %4 = tail call i32 @cq_measure_si32(i32 noundef %3) #7
  ret i32 %4
}

declare signext i8 @cq_theta_si8(i8 noundef signext, double noundef) local_unnamed_addr #5

; Function Attrs: nofree noinline nounwind ssp uwtable
define internal fastcc range(i32 -127, 129) i32 @show(i8 noundef signext %0) unnamed_addr #6 {
  %2 = sext i8 %0 to i32
  %3 = and i32 %2, 1
  %4 = icmp eq i32 %3, 0
  br i1 %4, label %8, label %5

5:                                                ; preds = %1
  %6 = load ptr, ptr @__stdoutp, align 8, !tbaa !6
  %7 = tail call i32 (ptr, ptr, ...) @fprintf(ptr noundef %6, ptr noundef nonnull @.str, i32 noundef %2) #7
  br label %8

8:                                                ; preds = %5, %1
  %9 = add nsw i32 %2, 1
  ret i32 %9
}

declare i32 @cq_measure_si32(i32 noundef) local_unnamed_addr #5

