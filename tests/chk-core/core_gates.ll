; Every core gate of BACKEND_ABI §1 handled by chk-core, plus one template forward/_unc pair.
target triple = "x86_64-apple-macosx16.0.0"

define i32 @core_all(i32 %x0, double %th) {
  %x = call i32 @cqrt_alloc_i32(i32 %x0)
  call void @cqrt_ry_i32(i32 %x, double %th)
  %f = call i32 @cqrt_alloc_i1(i1 true)
  %g = call i32 @cqrt_alloc_i1(i1 false)
  call void @cqrt_not_i1(i32 %g)
  %t = call i32 @cqrt_alloc_i1(i1 false)
  call void @cqrt_and_i1(i32 %f, i32 %g, i32 %t)
  call void @cqrt_rz_i1(i32 %t, double %th)
  call void @cqrt_and_i1(i32 %f, i32 %g, i32 %t)
  call void @cqrt_or_i1(i32 %f, i32 %g, i32 %t)
  call void @cqrt_xor_i1(i32 %f, i32 %t)
  call void @cqrt_free(i32 %t)
  %y = call i32 @cqrt_alloc_i32(i32 0)
  call void @cqrt_copy_i32(i32 %x, i32 %y)
  call void @cqrt_copy_i32_controlled(i32 %f, i32 %x, i32 %y)
  call void @cqrt_free(i32 %y)
  %z = call i32 @cqrt_alloc_i32(i32 5)
  call void @cqrt_xorc_i32(i32 %z, i32 3)
  call void @cqrt_xorc_i32_controlled(i32 %g, i32 %z, i32 6)
  call void @cqrt_ry_i32_controlled(i32 %f, i32 %z, double %th)
  %a = call i32 @cqrt_alloc_f64(double 5.000000e-01)
  %w = call i32 @cqrt_alloc_i8(i8 7)
  call void @cqrt_ry_i8_qangle(i32 %w, i32 %a)
  call void @cqrt_ry_i8_qangle_controlled(i32 %f, i32 %w, i32 %a)
  call void @cqrt_rz_qangle(i32 %a)
  call void @cqrt_rz_qangle_controlled(i32 %f, i32 %a)
  %s = call i32 @cq_template_add_i32_hl(i32 %x, i32 3)
  call void @cq_template_add_i32_hl_unc(i32 %s, i32 %x, i32 3)
  call void @cqrt_free(i32 %s)
  %b = call i32 @cq_template_add_i8_hl(i32 %w, i8 250)
  call void @cqrt_push(i32 %x)
  %p = call i32 @cqrt_pop()
  %fm = call i1 @cqrt_measure_i1(i32 %f)
  %am = call double @cqrt_measure_f64(i32 %a)
  call void @cqrt_free(i32 %g)
  %xm = call i32 @cqrt_measure_i32(i32 %x)
  %bm = call signext i8 @cqrt_measure_i8(i32 %b)
  %bw = sext i8 %bm to i32
  %same = icmp eq i32 %p, %x
  %one = zext i1 %same to i32
  %r0 = add i32 %xm, %one
  %r = add i32 %r0, %bw
  ret i32 %r
}

declare i32 @cqrt_alloc_i32(i32)
declare i32 @cqrt_alloc_i1(i1)
declare i32 @cqrt_alloc_i8(i8)
declare i32 @cqrt_alloc_f64(double)
declare void @cqrt_ry_i32(i32, double)
declare void @cqrt_ry_i32_controlled(i32, i32, double)
declare void @cqrt_ry_i8_qangle(i32, i32)
declare void @cqrt_ry_i8_qangle_controlled(i32, i32, i32)
declare void @cqrt_rz_i1(i32, double)
declare void @cqrt_rz_qangle(i32)
declare void @cqrt_rz_qangle_controlled(i32, i32)
declare void @cqrt_not_i1(i32)
declare void @cqrt_and_i1(i32, i32, i32)
declare void @cqrt_or_i1(i32, i32, i32)
declare void @cqrt_xor_i1(i32, i32)
declare void @cqrt_copy_i32(i32, i32)
declare void @cqrt_copy_i32_controlled(i32, i32, i32)
declare void @cqrt_xorc_i32(i32, i32)
declare void @cqrt_xorc_i32_controlled(i32, i32, i32)
declare void @cqrt_free(i32)
declare void @cqrt_push(i32)
declare i32 @cqrt_pop()
declare zeroext i1 @cqrt_measure_i1(i32)
declare double @cqrt_measure_f64(i32)
declare i32 @cqrt_measure_i32(i32)
declare signext i8 @cqrt_measure_i8(i32)
declare i32 @cq_template_add_i32_hl(i32, i32)
declare void @cq_template_add_i32_hl_unc(i32, i32, i32)
declare i32 @cq_template_add_i8_hl(i32, i8)
