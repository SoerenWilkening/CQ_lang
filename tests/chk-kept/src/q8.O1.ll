; Function Attrs: mustprogress nofree noinline nounwind ssp willreturn memory(write, argmem: none, inaccessiblemem: readwrite) uwtable
define noundef range(i32 0, 256) i32 @fill(i32 noundef %0) local_unnamed_addr #0 {
  %2 = zext i32 %0 to i64
  %3 = tail call ptr @malloc(i64 noundef %2) #4
  %4 = trunc i32 %0 to i8
  store i8 %4, ptr %3, align 1, !tbaa !6
  store ptr %3, ptr @sink, align 8, !tbaa !9
  %5 = and i32 %0, 255
  ret i32 %5
}

; Function Attrs: mustprogress nofree nounwind willreturn allockind("alloc,uninitialized") allocsize(0) memory(inaccessiblemem: readwrite)
declare noalias noundef ptr @malloc(i64 noundef) local_unnamed_addr #1

; Function Attrs: nounwind ssp uwtable
define i32 @q8(i32 noundef %0) local_unnamed_addr #2 {
  %2 = tail call i32 @cq_theta_si32(i32 noundef %0, double noundef 5.000000e-01) #5
  %3 = icmp ugt i32 %2, -17
  br i1 %3, label %4, label %6

4:                                                ; preds = %1
  %5 = tail call i32 @fill(i32 noundef %2)
  br label %6

6:                                                ; preds = %4, %1
  %7 = phi i32 [ %5, %4 ], [ 1, %1 ]
  %8 = tail call i32 @cq_measure_si32(i32 noundef %7) #6
  ret i32 %8
}

declare i32 @cq_theta_si32(i32 noundef, double noundef) local_unnamed_addr #3

