; Function Attrs: nounwind ssp uwtable
define i64 @heap_pass(i64 noundef %0, double noundef %1) local_unnamed_addr #0 {
  %3 = tail call dereferenceable_or_null(32) ptr @malloc(i64 noundef 32) #6
  %4 = tail call i64 @cq_theta_sl(i64 noundef %0, double noundef %1) #7
  tail call fastcc void @put(ptr noundef %3, i64 noundef %4)
  %5 = tail call fastcc i64 @get(ptr noundef %3)
  %6 = tail call i64 @cq_measure_sl(i64 noundef %5) #8
  tail call void @free(ptr noundef %3)
  ret i64 %6
}

; Function Attrs: mustprogress nofree nounwind willreturn allockind("alloc,uninitialized") allocsize(0) memory(inaccessiblemem: readwrite)
