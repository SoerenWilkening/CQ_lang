#!/usr/bin/env bash
# tools/cqc — CQ user-facing driver (Phase 6 multi-file, DD-6 §7.3).
#
# Orchestrates the taint-driven CQ pipeline over one CQ translation unit plus
# zero or more classical C libraries:
#   1. clang -O1 -emit-llvm per .c   (ONLY the CQ TU gets -include CQ.h — C18)
#   2. llvm-link the per-TU IR        (un-inlined bodies for the specializer,
#                                      plus the math.h bundle, bd 3c6m.72)
#   3. opt -passes=cq-lowering        (the single lowering pass; no inliner before)
#   4. clang link                     (exactly one installer-selected backend)
#
# There is NO AST rewriter / transpiler / cq_mid.h stage: the frontend is the
# CQ.h header lowered entirely in the IR pass (taint-driven design — Key
# Prohibitions, C21). cqc never emits -O2/-O3 and never runs an inlining pass
# before opt (Rule 9); -O1 per TU plus llvm-link-before-opt structurally preserve
# the visible callee body that call-graph specialization depends on.
#
# Usage:
#   cqc <cq_input.c> [lib.c ...] -o <output> [options]
#     --keep-intermediates    keep <output>.{combined,lowered}.<ext> next to <output>
#     --emit-ll               textual .ll intermediates instead of .bc (implies keep)
#     -g                      emit debug info, so a decline names its source line
#     --cq-prefix=<dir>       install/source prefix (default: $(dirname $0)/..)
#     --opt=<binary>          opt binary        (default: opt-19 / $LLVM_PREFIX)
#     --clang=<binary>        clang binary      (default: clang-19 / $LLVM_PREFIX)
#     --link=<binary>         llvm-link binary  (default: llvm-link-19 / $LLVM_PREFIX)
#     --uninstall             remove this installed CQ distribution
#     --yes                   skip the uninstall confirmation prompt
#     -o <output>             output executable
#     -h, --help              this message
#
# The FIRST positional is the CQ source (compiled with -include CQ.h); every
# later positional is a plain classical C library (compiled WITHOUT CQ.h).

set -euo pipefail

usage() {
    cat <<EOF
usage: cqc <cq_input.c> [lib.c ...] -o <output> [options]
  --keep-intermediates    keep <output>.{combined,lowered}.<ext> next to <output>
  --emit-ll               emit intermediates as textual .ll instead of .bc
                          (implies --keep-intermediates)
  -g                      emit debug info, so a decline names its source line
  --cq-prefix=<dir>       install/source prefix (default: $(dirname "$0")/..)
  --opt=<binary>          opt binary        (default: opt-19)
  --clang=<binary>        clang binary      (default: clang-19)
  --link=<binary>         llvm-link binary  (default: llvm-link-19)
  --uninstall            remove this installed CQ distribution
  --yes                  skip the uninstall confirmation prompt
  -o <output>             output executable
  -h, --help              this message

The first positional is the CQ source (compiled with -include CQ.h); every later
positional is a plain classical C library (compiled WITHOUT CQ.h).
EOF
}

resolve_script_path() {
    local target="$1" directory
    while [[ -L "$target" ]]; do
        directory="$(cd -P "$(dirname "$target")" && pwd)"
        target="$(readlink "$target")"
        [[ "$target" == /* ]] || target="$directory/$target"
    done
    directory="$(cd -P "$(dirname "$target")" && pwd)"
    printf '%s/%s' "$directory" "$(basename "$target")"
}

self_path="$(resolve_script_path "$0")"
inputs=(); output=""; keep=0; emit_ll=0; uninstall=0; assume_yes=0; debug_flag=()
prefix="$(cd "$(dirname "$self_path")/.." && pwd)"
opt_explicit=0; clang_explicit=0; link_explicit=0

# Pick LLVM tool binaries with the same priority chain as archive/cqc:
#   1. $LLVM_PREFIX/bin/<tool> — the README's macOS setup (brew llvm@19 is
#      keg-only, so LLVM_PREFIX is set but not on PATH).
#   2. `<name>-19` on PATH — Debian/Ubuntu llvm-19 layout.
#   3. `<name>` on PATH — Homebrew on PATH / generic LLVM.
#   4. Fall back to `<name>-19` so the missing-tool error names a concrete tool.
# --opt= / --clang= / --link= overrides bypass this chain entirely.
pick_bin() {
    local versioned="$1" unversioned="$2"
    if [[ -n "${LLVM_PREFIX:-}" && -x "$LLVM_PREFIX/bin/$unversioned" ]]; then
        printf '%s' "$LLVM_PREFIX/bin/$unversioned"
    elif command -v "$versioned" >/dev/null 2>&1; then printf '%s' "$versioned"
    elif command -v "$unversioned" >/dev/null 2>&1; then printf '%s' "$unversioned"
    else printf '%s' "$versioned"  # let the stage error surface the missing tool
    fi
}
opt_bin="$(pick_bin opt-19 opt)"
clang_bin="$(pick_bin clang-19 clang)"
link_bin="$(pick_bin llvm-link-19 llvm-link)"

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)              usage; exit 0 ;;
        -o)                     output="$2"; shift 2 ;;
        --keep-intermediates)   keep=1; shift ;;
        --emit-ll)              keep=1; emit_ll=1; shift ;;
        -g)                     debug_flag=(-g); shift ;;
        --cq-prefix=*)          prefix="${1#*=}"; shift ;;
        --cq-prefix)            prefix="$2"; shift 2 ;;
        --opt=*)                opt_bin="${1#*=}"; opt_explicit=1; shift ;;
        --opt)                  opt_bin="$2"; opt_explicit=1; shift 2 ;;
        --clang=*)              clang_bin="${1#*=}"; clang_explicit=1; shift ;;
        --clang)                clang_bin="$2"; clang_explicit=1; shift 2 ;;
        --link=*)               link_bin="${1#*=}"; link_explicit=1; shift ;;
        --link)                 link_bin="$2"; link_explicit=1; shift 2 ;;
        --uninstall)            uninstall=1; shift ;;
        --yes)                  assume_yes=1; shift ;;
        -*) echo "cqc: unknown flag: $1" >&2; usage >&2; exit 2 ;;
        *)  inputs+=("$1"); shift ;;
    esac
done

uninstall_cq() {
    local manifest="" candidate marker owned canonical_parent answer directory
    local self_listed=0
    local -a owned_paths=()

    for candidate in "$prefix"/*/cq/CQInstallManifest.txt; do
        [[ -f "$candidate" ]] || continue
        [[ -z "$manifest" ]] || {
            echo "cqc: multiple uninstall manifests found under $prefix" >&2
            return 3
        }
        manifest="$candidate"
    done
    [[ -n "$manifest" ]] || {
        echo "cqc: no installer-owned manifest under $prefix; refusing to uninstall" >&2
        return 3
    }

    IFS= read -r marker < "$manifest"
    [[ "$marker" == "# CQ install manifest v1" ]] || {
        echo "cqc: invalid uninstall manifest: $manifest" >&2
        return 3
    }
    while IFS= read -r owned; do
        [[ -n "$owned" ]] || continue
        [[ "$owned" == /* && "$owned" == "$prefix"/* && "$owned" != *"/../"* && "$owned" != */.. ]] || {
            echo "cqc: unsafe uninstall path outside $prefix: $owned" >&2
            return 3
        }
        if [[ -e "$owned" || -L "$owned" ]]; then
            canonical_parent="$(cd -P "$(dirname "$owned")" && pwd)" || {
                echo "cqc: cannot validate uninstall path: $owned" >&2
                return 3
            }
            [[ "$canonical_parent" == "$prefix" || "$canonical_parent" == "$prefix"/* ]] || {
                echo "cqc: unsafe uninstall path through symlink: $owned" >&2
                return 3
            }
        fi
        [[ "$owned" == "$self_path" ]] && self_listed=1
        owned_paths+=("$owned")
    done < <(tail -n +2 "$manifest")
    [[ "$self_listed" == "1" ]] || {
        echo "cqc: uninstall manifest does not own this executable: $self_path" >&2
        return 3
    }

    if [[ "$assume_yes" != "1" ]]; then
        [[ -t 0 ]] || {
            echo "cqc: confirmation requires a terminal; rerun with --uninstall --yes" >&2
            return 2
        }
        read -r -p "Remove CQ from $prefix? [y/N] " answer
        case "$answer" in y|Y|yes|YES) ;; *) echo "cqc: uninstall cancelled"; return 0 ;; esac
    fi

    for owned in "${owned_paths[@]}"; do
        [[ ! -e "$owned" && ! -L "$owned" ]] || rm -f -- "$owned"
    done
    while IFS= read -r directory; do
        while [[ "$directory" == "$prefix"/* ]]; do
            rmdir "$directory" 2>/dev/null || break
            directory="$(dirname "$directory")"
        done
    done < <(
        for owned in "${owned_paths[@]}"; do dirname "$owned"; done | sort -ru
    )
    echo "CQ uninstalled from $prefix"
}

if [[ "$uninstall" == "1" ]]; then
    [[ ${#inputs[@]} -eq 0 && -z "$output" ]] || {
        echo "cqc: --uninstall cannot be combined with compilation inputs or -o" >&2
        exit 2
    }
    uninstall_cq
    exit $?
fi
[[ "$assume_yes" == "0" ]] || { echo "cqc: --yes requires --uninstall" >&2; exit 2; }

[[ ${#inputs[@]} -gt 0 ]] || { echo "cqc: missing <cq_input.c>" >&2; usage >&2; exit 2; }
[[ -n "$output"       ]] || { echo "cqc: missing -o <output>" >&2; usage >&2; exit 2; }
for f in "${inputs[@]}"; do
    [[ -f "$f" ]] || { echo "cqc: input not found: $f" >&2; exit 2; }
done

# Resolve an artifact from the installed or in-tree layouts.
find_artifact() {
    local name="$1" rel
    shift
    for rel in "$@"; do
        if [[ -e "$prefix/$rel" ]]; then printf '%s' "$prefix/$rel"; return 0; fi
    done
    echo "cqc: cannot locate $name under $prefix (tried: $*)" >&2
    return 1
}

[[ -d "$prefix/include" ]] || { echo "cqc: missing $prefix/include (CQ.h)" >&2; exit 3; }

backend_link_items=()
backend_selection=""
for candidate in "$prefix"/*/cq/CQBackendSelection.sh; do
    [[ -f "$candidate" ]] || continue
    [[ -z "$backend_selection" ]] || {
        echo "cqc: multiple installed backend selections found under $prefix" >&2
        exit 3
    }
    backend_selection="$candidate"
done
if [[ -n "$backend_selection" ]]; then
    # Trusted, shell-quoted configuration generated by tools/install_cq.py.
    source "$backend_selection"
    [[ ${#CQ_BACKEND_LINK_ITEMS[@]} -gt 0 ]] || {
        echo "cqc: installed backend selection has no link items: $backend_selection" >&2
        exit 3
    }
    backend_link_items=("${CQ_BACKEND_LINK_ITEMS[@]}")
    pass_so="$(dirname "$backend_selection")/libCQPass.so"
    [[ -f "$pass_so" ]] || {
        echo "cqc: installed pass missing next to $backend_selection" >&2
        exit 3
    }
    libm_bundle="$(dirname "$backend_selection")/cq_libm.bc"
    [[ -f "$libm_bundle" ]] || {
        echo "cqc: installed math.h bundle missing next to $backend_selection" >&2
        exit 3
    }
    if [[ -n "${CQ_LLVM_BIN:-}" ]]; then
        [[ "$opt_explicit" == "1" ]] || opt_bin="$CQ_LLVM_BIN/opt"
        [[ "$clang_explicit" == "1" ]] || clang_bin="$CQ_LLVM_BIN/clang"
        [[ "$link_explicit" == "1" ]] || link_bin="$CQ_LLVM_BIN/llvm-link"
    fi
else
    # Source-tree development fallback: the two trace archives form one backend.
    pass_so="$(find_artifact libCQPass.so lib/libCQPass.so \
        build/ir-pass/libCQPass.so build-install/ir-pass/libCQPass.so)" || exit 3
    libm_bundle="$(find_artifact cq_libm.bc lib/cq/cq_libm.bc \
        build/libm/cq_libm.bc build-install/libm/cq_libm.bc)" || exit 3
    tpl_lib="$(find_artifact libcq_templates.a lib/libcq_templates.a \
        build/runtime/libcq_templates.a build-install/runtime/libcq_templates.a)" || exit 3
    rt_lib="$(find_artifact libcq_runtime.a lib/libcq_runtime.a \
        build/runtime/libcq_runtime.a build-install/runtime/libcq_runtime.a)" || exit 3
    backend_link_items=("$tpl_lib" "$rt_lib")
fi

# Intermediate IR format: --emit-ll switches .bc bitcode to .ll text and toggles
# -S on clang stage 1 / opt stage 3 / llvm-link stage 2 (each accepts either as
# input transparently). Empty *_emit_flag arrays are expanded with the bash-3.2
# safe "${arr[@]+...}" idiom (macOS /bin/bash is 3.2; a bare "${arr[@]}" on an
# empty array under set -u is an unbound-variable error there).
ir_ext="bc"; clang_emit_flag="-c"; link_emit_flag=(); opt_emit_flag=()
if [[ "$emit_ll" == "1" ]]; then
    ir_ext="ll"; clang_emit_flag="-S"; link_emit_flag=(-S); opt_emit_flag=(-S)
fi

out_base="$(basename "$output")"
if [[ "$keep" == "1" ]]; then
    work="$(dirname "$output")"
else
    work="$(mktemp -d)"; trap 'rm -rf "$work"' EXIT
fi
combined="$work/$out_base.combined.$ir_ext"
lowered="$work/$out_base.lowered.$ir_ext"

run_stage() {
    local label="$1"; shift
    if ! "$@"; then echo "cqc: stage $label failed" >&2; exit 4; fi
}

# Stage 1: per-TU clang -O1 -emit-llvm. The FIRST input is the CQ TU and gets
# -include CQ.h; every later input is a classical C library and does NOT (C18).
tu_irs=()
idx=0
for src in "${inputs[@]}"; do
    tu_ir="$work/$out_base.tu_$idx.$ir_ext"
    if [[ "$idx" == "0" ]]; then
        run_stage compile "$clang_bin" -O1 "${debug_flag[@]+"${debug_flag[@]}"}" \
            -emit-llvm "$clang_emit_flag" "$src" \
            -include CQ.h -I"$prefix/include" -o "$tu_ir"
    else
        run_stage compile "$clang_bin" -O1 "${debug_flag[@]+"${debug_flag[@]}"}" \
            -emit-llvm "$clang_emit_flag" "$src" \
            -I"$prefix/include" -o "$tu_ir"
    fi
    tu_irs+=("$tu_ir")
    idx=$((idx + 1))
done

# Stage 2: llvm-link the per-TU IR into one module — gives the specializer the
# un-inlined callee bodies (llvm-link, not a multi-input clang invocation).
# A program that uses a CQ primitive (`cq_*`) also gets the math.h bundle
# (bd 3c6m.72): every body under the prefixed name `__cq_libm_<name>` (external
# until the pass internalizes the survivors), so no classical call changes
# callee; the pass binds a call with a quantum operand to its body and erases
# the bodies nothing uses. A purely classical program never sees the
# bundle, so its module is exactly what it was (owner ruling 2026-10-06).
# Bitcode even under --emit-ll: llvm-nm reads no textual IR.
user_ir="$work/$out_base.user.bc"
run_stage link-ir "$link_bin" "${tu_irs[@]}" -o "$user_ir"
if [[ "$link_bin" == */* ]]; then nm_bin="$(dirname "$link_bin")/llvm-nm"
else nm_bin="$(pick_bin llvm-nm-19 llvm-nm)"; fi
undefined_syms="$("$nm_bin" --undefined-only "$user_ir")" || {
    echo "cqc: stage scan failed ($nm_bin)" >&2; exit 4; }
if grep -qE '(^|[[:space:]])_?cq_' <<< "$undefined_syms"; then
    run_stage link-libm "$link_bin" "${link_emit_flag[@]+"${link_emit_flag[@]}"}" \
        "$user_ir" "$libm_bundle" -o "$combined"
else
    run_stage link-ir "$link_bin" "${link_emit_flag[@]+"${link_emit_flag[@]}"}" \
        "$user_ir" -o "$combined"
fi

# Stage 3: opt cq-lowering over the combined module (no inliner before it).
run_stage lower "$opt_bin" -load-pass-plugin "$pass_so" \
    -passes=cq-lowering "${opt_emit_flag[@]+"${opt_emit_flag[@]}"}" "$combined" -o "$lowered"

# Stage 4: link exactly the selected backend. For the trace fallback, templates
# remain before runtime (load-bearing, C18).
run_stage link "$clang_bin" "$lowered" "${backend_link_items[@]}" -o "$output"
